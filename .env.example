# Скопируйте в .env и заполните секреты.
TELEGRAM_TOKEN=
GEMINI_API_KEY=

GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=imagen-3.0-generate-001
GEMINI_TEST_MODEL=gemini-3.8-flash

MAX_FILE_SIZE_MB=20
MAX_503_RETRIES=3
RETRY_DELAY_SECONDS=4
TELEGRAM_POLLING_TIMEOUT=20
TELEGRAM_LONG_POLLING_TIMEOUT=10

MARKS_DB_PATH=data/marks.db
MARKS_STORAGE_DIR=data/marks_pdfs
MARKS_SCAN_DPI=200
MARKS_GRID_COLUMNS=8
MARKS_GRID_ROWS=8
MARKS_CELL_WIDTH_PT=136.063
MARKS_CELL_HEIGHT_PT=93.5433
MARKS_HIGHLIGHT_OPACITY=0.28
MARKS_MAX_QUANTITY=100
